{
  "name": "flyleaf-reader-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "check": "npm run lint && npm run build",
    "test": "vitest run && node --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "test:e2e": "node scripts/reader-check.mjs && node scripts/ui-check.mjs",
    "check:reader": "node scripts/reader-check.mjs",
    "check:ui": "node scripts/ui-check.mjs"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/literata": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.10",
    "clsx": "^2.1.1",
    "epubjs": "^0.3.93",
    "localforage": "^1.10.0",
    "lucide-react": "^0.453.0",
    "material-symbols": "^0.40.2",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-swipeable": "^7.0.2",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "fake-indexeddb": "^6.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.48.2",
    "postcss": "^8.4.47",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.14",
    "vitest": "^5.0.5"
  }
}
